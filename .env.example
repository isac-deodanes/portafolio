# Copia este archivo a ".env" para desarrollo local:  cp .env.example .env
# En Vercel: Project Settings → Environment Variables → agrega la(s) misma(s) clave(s).
#
# Nota: cualquier variable que empiece con VITE_ queda incluida en el bundle
# del navegador (no es secreta). No pongas aquí contraseñas ni API keys privadas.

# Endpoint del formulario de contacto (por ejemplo, un formulario de Formspree:
# https://formspree.io — crea uno gratis y pega la URL que te dan aquí).
# Si se deja vacío, el formulario de contacto simplemente abrirá el correo del visitante.
VITE_FORM_ENDPOINT=

# Opcional: si más adelante agregas Google Analytics, Plausible, etc.
VITE_ANALYTICS_ID=
